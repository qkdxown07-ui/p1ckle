#include <stdio.h>

struct Body {
    int height;
    double weight;
};

struct Body makeStudent(struct Body f, struct Body m) {
    struct Body s;
    s.height = (f.height + m.height) / 2 + 5;
    s.weight = (f.weight + m.weight) / 2 - 4.5;
    return s;
}

int main() {
    struct Body f, m, s;

    scanf("%d %lf", &f.height, &f.weight);
    scanf("%d %lf", &m.height, &m.weight);

    s = makeStudent(f, m);

    printf("height : %dcm\n", s.height);
    printf("weight : %.1fkg\n", s.weight);

    return 0;
}
