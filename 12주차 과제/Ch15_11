#include <stdio.h>

struct Point {
    double x;
    double y;
};

int main() {
    struct Point a, b, c;

    scanf("%lf %lf", &a.x, &a.y);
    scanf("%lf %lf", &b.x, &b.y);

    c.x = (a.x + b.x) / 2;
    c.y = (a.y + b.y) / 2;

    printf("Center point = (%.1f, %.1f)\n", c.x, c.y);

    return 0;
}
